# copy to ~/.local/share/tile2ha/env and `chmod 600` it
HA_URL=http://homeassistant.local:8123
HA_TOKEN=PASTE_LONG_LIVED_TOKEN_HERE
# static HA zone this scanner is in (create it in Settings -> Areas, labels & zones -> Zones)
TILE_ZONE=zone.home
# optional: name shown in the `source` attribute (default: hostname)
#TILE_SOURCE=nucbox
# optional: report the same advertisement at most once per N seconds
TILE_REPORT_INTERVAL=30
